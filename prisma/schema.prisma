generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===========================
// CORE MARITIME DOMAIN MODELS
// ===========================

model Port {
  id                String   @id @default(cuid())
  name              String
  countryCode       String
  region            String
  latitude          Float
  longitude         Float
  unlocode          String?  @unique
  portType          String?  @default("Seaport")
  harborSize        String?
  shelter           String?
  depth             Float?
  cargoTypes        String?  @default("General Cargo")
  tidalRange        Float?
  remarks           String?
  // Enriched attributes
  timezone          String?
  population        Int?
  totalArea         Float? // sq km
  annualTEU         Int? // container throughput per year
  annualDWT         Int? // deadweight throughput per year
  maxVesselDWT      Int? // max vessel size accepted
  berthCount        Int?
  craneCount        Int?
  pilotage          String?  @default("Compulsory")
  tugsAvailable     Int?
  bunkering         Boolean  @default(false)
  freshWater        Boolean  @default(false)
  medicalFacility   Boolean  @default(false)
  repairFacility    Boolean  @default(false)
  warehouseSpace    Float? // sq meters
  coldStorage       Boolean  @default(false)
  hazardousHandling String?  @default("None")
  congestionLevel   String?  @default("Low") // Low, Medium, High, Critical
  avgWaitHours      Float?
  avgStayHours      Float?
  owner             String?
  operator          String?
  website           String?
  lastUpdated       DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  originShipments Shipment[]        @relation("ShipmentOrigin")
  destShipments   Shipment[]        @relation("ShipmentDest")
  arrivals        VesselArrival[]
  departures      VesselDeparture[]
  bookingOrigins  Booking[]         @relation("BookingOrigin")
  bookingDests    Booking[]         @relation("BookingDest")
}

model Vessel {
  id                    String    @id @default(cuid())
  mmsi                  Int       @unique
  imo                   Int?      @unique
  name                  String
  callSign              String?
  vesselType            String    @default("Cargo")
  flagCountry           String?
  grossTonnage          Float?
  deadweight            Float?
  length                Float?
  breadth               Float?
  draft                 Float?
  yearBuilt             Int?
  status                String    @default("Active") // Active, In Port, At Anchor, Underway, Moored, Aground
  lastPosition          DateTime?
  latitude              Float?
  longitude             Float?
  speed                 Float?    @default(0)
  heading               Float?
  destination           String?
  eta                   DateTime?
  // Enriched attributes
  formerName            String?
  formerFlag            String?
  classificationSociety String? // e.g. "Lloyd's Register", "DNV GL", "Bureau Veritas"
  vesselClass           String? // e.g. "Panamax", "VLCC", "Capesize", "Suezmax", "Post-Panamax", "ULCS"
  iceClass              String? // e.g. "ICE-1A", "Polar Code", "None"
  engineType            String? // e.g. "Diesel", "LNG Dual-Fuel", "Steam Turbine"
  enginePower           Float? // kW
  maxSpeed              Float? // knots
  fuelCapacity          Float? // cubic meters
  fuelType              String? // e.g. "VLSFO", "LNG", "HFO"
  teuCapacity           Int? // for container ships
  reeferPoints          Int? // reefer container plugs
  cargoHoldCount        Int?
  craneCount            Int? // onboard cranes
  doubleHull            Boolean   @default(true)
  bulbousBow            Boolean   @default(true)
  crewCapacity          Int?
  passengers            Int?
  shipManager           String? // technical manager
  ismManager            String? // ISM code manager
  registeredOwner       String?
  beneficialOwner       String?
  insurancePandI        String? // P&I Club name
  insuranceHull         String? // Hull & Machinery insurer
  imoCertExpiry         DateTime?
  ismcCertExpiry        DateTime?
  solasCompliant        Boolean   @default(true)
  marpolCompliant       Boolean   @default(true)
  ballastWater          String? // ballast water management type
  antiFouling           String?
  emissionRating        String? // e.g. "A", "B", "C", "D" (existing EEXI/CII)
  totalVoyages          Int?      @default(0)
  totalDistanceNm       Float?    @default(0)
  ownerCountry          String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  carrierId    String?
  tradeRouteId String?

  carrier    Carrier?           @relation(fields: [carrierId], references: [id])
  tradeRoute TradeRoute?        @relation(fields: [tradeRouteId], references: [id])
  arrivals   VesselArrival[]
  departures VesselDeparture[]
  containers Container[]
  shipments  Shipment[]
  documents  ShipmentDocument[]
  charters   Charter[]
  bookings   Booking[]
}

model Shipment {
  id                 String    @id @default(cuid())
  billOfLading       String?   @unique
  bookingRef         String?
  status             String    @default("Booked") // Booked, Customs Clearance, In Transit, Arrived, Discharging, Delivered, Cancelled
  cargoType          String?
  cargoWeight        Float?    @default(0)
  cargoValue         Float?
  cargoDesc          String?
  hsCode             String?
  vesselId           String
  originPortId       String
  destPortId         String
  departureDate      DateTime?
  arrivalDate        DateTime?
  etd                DateTime?
  eta                DateTime?
  transitDays        Int?
  freightCost        Float?
  currency           String    @default("USD")
  shipper            String?
  consignee          String?
  // Enriched attributes
  notifyParty        String?
  forwarder          String? // freight forwarder
  agent              String? // customs broker / agent
  incoterms          String? // e.g. "FOB", "CIF", "EXW", "DDP", "CFR"
  paymentTerms       String? // e.g. "Net 30", "L/C", "T/T", "CAD"
  freightTerms       String? // e.g. "Prepaid", "Collect", "Prepaid at Destination"
  containerCount     Int?
  totalTEU           Float?
  totalFEU           Float?
  weightUnit         String?   @default("KG")
  volumeCbm          Float? // cubic meters
  dangerousGoods     Boolean   @default(false)
  dgClass            String? // e.g. "Class 3", "Class 9"
  unNumber           String? // UN number for DG
  temperatureCtrl    Boolean   @default(false)
  tempMin            Float? // Celsius
  tempMax            Float? // Celsius
  insurancePolicy    String?
  insuranceValue     Float?
  certificateNo      String? // phytosanitary, origin cert, etc.
  customsStatus      String?   @default("Pending") // Pending, Cleared, Held, Rejected
  customsRef         String?
  clearedAt          DateTime?
  inspectionRequired Boolean   @default(false)
  inspectionDate     DateTime?
  demurrage          Float? // charges
  detention          Float? // charges
  storageCharges     Float?
  remarks            String?
  priority           String?   @default("Standard") // Standard, Express, Priority, Economy
  serviceLevel       String?   @default("FCL") // FCL, LCL, Break Bulk, Project Cargo
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  carrierId    String?
  tradeRouteId String?

  vessel     Vessel             @relation(fields: [vesselId], references: [id])
  carrier    Carrier?           @relation(fields: [carrierId], references: [id])
  tradeRoute TradeRoute?        @relation(fields: [tradeRouteId], references: [id])
  originPort Port               @relation("ShipmentOrigin", fields: [originPortId], references: [id])
  destPort   Port               @relation("ShipmentDest", fields: [destPortId], references: [id])
  containers Container[]
  documents  ShipmentDocument[]
  events     ShipmentEvent[]
  bookings   Booking[]
}

model Container {
  id               String    @id @default(cuid())
  containerNo      String    @unique
  isoType          String?   @default("20DRY")
  size             String?   @default("20FT")
  status           String    @default("Empty") // Empty, Loaded, In Transit, Arrived, Stripped, Returned, Repositioning, Repair
  weight           Float?    @default(0)
  vesselId         String?
  shipmentId       String?
  originPort       String?
  destPort         String?
  // Enriched attributes
  owner            String? // leasing company or carrier
  lessee           String?
  maxPayload       Float?
  tareWeight       Float? // empty weight
  cubicCapacity    Float? // cubic meters
  manufacturer     String?
  yearManufactured Int?
  lastInspection   DateTime?
  nextInspection   DateTime?
  cscExpiry        DateTime? // CSC plate expiry
  damaged          Boolean   @default(false)
  damageDesc       String?
  sealNo           String?
  sealType         String? // e.g. "Bolt", "Cable", "Wire")
  commodityCode    String?
  commodityDesc    String?
  temperature      Float? // current temp for reefers
  humidity         Float? // for reefers
  ventSetting      String?
  isInYard         Boolean   @default(false)
  yardLocation     String?
  yardEntryDate    DateTime?
  freeDays         Int? // free detention days at destination
  demurrageStart   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  vessel   Vessel?   @relation(fields: [vesselId], references: [id])
  shipment Shipment? @relation(fields: [shipmentId], references: [id])
}

model TradeData {
  id               String   @id @default(cuid())
  reporterCode     String
  reporterName     String?
  partnerCode      String
  partnerName      String?
  year             Int
  month            Int?
  tradeFlow        String // Import, Export, Re-export
  commodityCode    String // HS Code
  commodityChapter String? // HS Chapter (2-digit)
  commodityDesc    String?
  grossWeightKg    Float?
  netWeightKg      Float?
  tradeValueUsd    Float?
  quantity         Float?
  qtyUnit          String? // e.g. "kg", "number", "litres"
  unitValueUsd     Float? // unit price
  originPort       String?
  destPort         String?
  transportMode    String?  @default("Sea")
  customsRegime    String? // e.g. "General", "Bonded Warehouse", "Free Zone"
  dataSource       String?  @default("UN Comtrade")
  // Enriched attributes
  vesselType       String? // Container, Bulk, Tanker, Ro-Ro
  estimatedVoyages Int?
  co2EmissionsT    Float? // estimated CO2 in tonnes
  freightRateUsd   Float? // per tonne/km
  transshipment    Boolean  @default(false)
  tradeRoute       String? // e.g. "Asia-Europe", "Trans-Pacific", "Intra-Asia"
  fetchedAt        DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ShipmentDocument {
  id         String    @id @default(cuid())
  shipmentId String
  vesselId   String
  docType    String // BOL, Commercial Invoice, Packing List, Customs Declaration, COO, Phytosanitary, Insurance, BL Amendment
  docName    String
  docRef     String? // reference number
  status     String    @default("Pending") // Pending, Approved, Rejected, Expired
  issuedBy   String?
  issuedAt   DateTime?
  expiryDate DateTime?
  fileSize   Int? // bytes
  fileFormat String? // PDF, DOCX, XLSX
  remarks    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  vessel   Vessel   @relation(fields: [vesselId], references: [id], onDelete: Cascade)
  workflow DocumentWorkflow?
}

model ShipmentEvent {
  id              String   @id @default(cuid())
  shipmentId      String
  sequence        Int      @default(0) // Event ordering within the shipment (Leap 2: Event Sourcing)
  eventType       String // Booked, CustomsFiled, CustomsCleared, CustomsHeld, CustomsReleased, CustomsRejected, GateIn, Loaded, Departed, AtSea, Approaching, Arrived, Discharging, DischargeComplete, GateOut, Delivered, Exception, ExceptionResolved, Cancelled, Archived
  previousState   String?  @default("Booked") // State before this event (Leap 2)
  computedState   String?  @default("Booked") // State after this event (Leap 2)
  eventDesc       String?
  location        String?
  countryCode     String?
  latitude        Float?
  longitude       Float?
  vesselName      String?
  performedBy     String?  // Who triggered this event (Leap 2: actor)
  actor           String?  @default("system") // system | user | automated | customs | carrier | terminal (Leap 2)
  metadata        String?  // JSON payload for additional context (Leap 2)
  isValid         Boolean  @default(true) // Whether the transition was valid per statechart (Leap 1)
  createdAt       DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, sequence])
  @@index([shipmentId, eventType])
  @@index([computedState])
}

model VesselArrival {
  id               String   @id @default(cuid())
  vesselId         String
  portId           String
  arrivalAt        DateTime @default(now())
  purpose          String?  @default("Cargo") // Cargo, Bunkering, Repair, Crew Change, Customs, Pilotage
  // Enriched attributes
  berth            String?
  pilotName        String?
  agent            String?
  cargoDesc        String?
  dischargeTonnage Float?
  loadTonnage      Float?
  stayHours        Float?
  createdAt        DateTime @default(now())

  vessel Vessel @relation(fields: [vesselId], references: [id])
  port   Port   @relation(fields: [portId], references: [id])
}

model VesselDeparture {
  id           String    @id @default(cuid())
  vesselId     String
  portId       String
  departedAt   DateTime  @default(now())
  destination  String?
  // Enriched attributes
  berth        String?
  nextPortETA  DateTime?
  draft        Float?
  cargoOnboard String?
  createdAt    DateTime  @default(now())

  vessel Vessel @relation(fields: [vesselId], references: [id])
  port   Port   @relation(fields: [portId], references: [id])
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String?  // bcrypt hash for credentials auth (Phase 6)
  name          String?
  role          String   @default("Viewer") // Admin, Manager, Viewer, Shipper, Carrier, Customs, Terminal
  organization  String?  // company / organization name (Phase 6 multi-party)
  actorType     String?  @default("Internal") // Internal, Shipper, Carrier, CustomsBroker, TerminalOperator (Phase 6)
  phone         String?
  timezone      String?
  avatar        String?  // avatar URL or initials
  isActive      Boolean  @default(true) // soft-disable accounts (Phase 6)
  lastLoginAt   DateTime? // track last login (Phase 6)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  auditLogs        AuditLog[]
  documentActions   DocumentWorkflowAction[] @relation("DocumentActions")
  assignedWorkflows DocumentWorkflow[]  @relation("AssignedWorkflows")
}

// ===========================
// EXTENDED DOMAIN MODELS
// ===========================

model Carrier {
  id               String   @id @default(cuid())
  name             String
  code             String?  @unique // SCAC or carrier code, e.g. "MAEU" for Maersk
  country          String?
  headquarters     String?
  website          String?
  foundedYear      Int?
  fleetSize        Int? // number of vessels
  totalTEUCapacity Int? // total fleet TEU
  alliance         String? // e.g. "2M", "Ocean Alliance", "THE Alliance", "Independent"
  isTop20          Boolean  @default(false)
  isFCL            Boolean  @default(true)
  isLCL            Boolean  @default(true)
  isBreakBulk      Boolean  @default(false)
  isReefer         Boolean  @default(true)
  isDG             Boolean  @default(true)
  serviceRoutes    String? // comma-separated route codes
  transitTimeDays  Int? // avg transit across major routes
  reliability      Float? // on-time percentage 0-100
  co2PerTeu        Float? // grams CO2 per TEU-km
  contactEmail     String?
  contactPhone     String?
  remarks          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  vessels   Vessel[]
  shipments Shipment[]
  charters  Charter[]
  bookings  Booking[]
}

model TradeRoute {
  id               String   @id @default(cuid())
  name             String // e.g. "Asia–North America West Coast", "Trans-Atlantic"
  code             String?  @unique // e.g. "ANWC", "TAT"
  originRegion     String
  destRegion       String
  originPorts      String? // comma-separated UN/LOCODEs
  destPorts        String? // comma-separated UN/LOCODEs
  distanceNm       Float? // nautical miles
  avgTransitDays   Float?
  avgFreightPerTEU Float?
  majorCarriers    String? // comma-separated carrier codes
  vesselTypes      String? // e.g. "Container, Ro-Ro"
  weeklyFrequency  Int?
  seasonalPeak     String? // e.g. "Q4 Pre-Holiday", "Q1 Post-CNY"
  canalTransit     String? // e.g. "Suez", "Panama", "None"
  piracyRisk       String?  @default("Low") // Low, Medium, High
  congestionIndex  Float? // 0-100
  remarks          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  shipments Shipment[]
  vessels   Vessel[]
}

model CargoType {
  id                  String   @id @default(cuid())
  hsCode              String?  @unique
  hsChapter           String?
  name                String
  description         String?
  category            String? // e.g. "Containerized", "Bulk Dry", "Bulk Liquid", "Break Bulk", "Reefer"
  dangerous           Boolean  @default(false)
  dgClass             String?
  temperatureRequired Boolean  @default(false)
  tempRange           String? // e.g. "-18°C to -25°C"
  humidityControl     Boolean  @default(false)
  ventilationRequired Boolean  @default(false)
  stackingAllowed     Boolean  @default(true)
  maxStackWeight      Float? // kg
  commodityGroup      String? // e.g. "Agriculture", "Manufactured", "Minerals", "Energy"
  tradeVolume         Float? // annual global tonnes
  unitValue           Float? // average USD per tonne
  remarks             String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Charter {
  id             String    @id @default(cuid())
  vesselId       String
  carrierId      String?
  charterer      String? // company name
  charterType    String    @default("Voyage") // Voyage, Time, Bareboat, Demise
  startDate      DateTime?
  endDate        DateTime?
  durationDays   Int?
  ratePerDay     Float?
  currency       String    @default("USD")
  totalValue     Float?
  deliveryPort   String?
  redeliveryPort String?
  offHireAllowed Boolean   @default(false)
  bunkers        String? // "Owner's", "Charterer's", "Shared"
  status         String    @default("Active") // Active, Completed, Terminated, Pending
  remarks        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  vessel  Vessel   @relation(fields: [vesselId], references: [id])
  carrier Carrier? @relation(fields: [carrierId], references: [id])
}

model Booking {
  id                  String    @id @default(cuid())
  bookingNumber       String    @unique
  shipmentId          String?
  carrierId           String?
  vesselId            String
  originPortId        String
  destPortId          String
  bookingDate         DateTime?
  cutoffDate          DateTime?
  siCutoffDate        DateTime? // shipping instruction
  docCutoffDate       DateTime? // documentation
  status              String    @default("Confirmed") // Pending, Confirmed, Cancelled, No-Show, Rolled
  containerCount      Int       @default(1)
  teuBooked           Float?
  weightBookedKg      Float?
  commodity           String?
  specialInstructions String?
  equipmentType       String? // e.g. "20GP", "40HC", "40RF"
  rate                Float?
  rateCurrency        String    @default("USD")
  rateType            String? // "FAK", "Contract", "Spot"
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  shipment   Shipment? @relation(fields: [shipmentId], references: [id])
  carrier    Carrier?  @relation(fields: [carrierId], references: [id])
  vessel     Vessel    @relation(fields: [vesselId], references: [id])
  originPort Port      @relation("BookingOrigin", fields: [originPortId], references: [id])
  destPort   Port      @relation("BookingDest", fields: [destPortId], references: [id])
}

// ===========================
// PHASE 6: DIGITAL SUPPLY CHAIN
// ===========================

// Document Workflow — tracks the full lifecycle of shipping documents
// through submission, review, approval/rejection with audit trail.
// State machine: Draft → Submitted → UnderReview → Approved / Rejected → Archived

model DocumentWorkflow {
  id              String   @id @default(cuid())
  documentId      String   @unique // references ShipmentDocument.id
  workflowType    String   @default("Standard") // Standard, Expedited, Compliance, Financial
  currentStep    String   @default("Draft") // Draft, Submitted, UnderReview, Approved, Rejected, Archived
  priority        String   @default("Normal") // Low, Normal, High, Urgent
  // Access control — who can view/act on this workflow
  requiredRole    String?  @default("Admin") // minimum role to approve: Admin, Manager, Customs, Carrier
  assignedToId    String?  // User currently responsible for next action
  // SLA tracking
  submittedAt     DateTime?
  reviewedAt      DateTime?
  completedAt     DateTime?
  slaDeadline     DateTime? // deadline for review completion
  slaBreached     Boolean  @default(false)
  // Metadata
  rejectionReason String?
  remarks         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  document ShipmentDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  assignedTo User?             @relation("AssignedWorkflows", fields: [assignedToId], references: [id])
  actions    DocumentWorkflowAction[]

  @@index([currentStep])
  @@index([assignedToId])
  @@index([workflowType])
  @@index([submittedAt])
}

// Individual actions within a document workflow — immutable audit trail

model DocumentWorkflowAction {
  id          String   @id @default(cuid())
  workflowId  String
  action      String   // Submitted, Assigned, Reviewed, Approved, Rejected, Resubmitted, Archived, Commented
  fromStep    String   // state before this action
  toStep      String   // state after this action
  performedBy String   // User.id who performed the action
  actorRole   String?  // role at time of action
  comment     String?  // optional comment or reason
  metadata    String?  // JSON payload for additional context
  createdAt   DateTime @default(now())

  workflow DocumentWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  performer User             @relation("DocumentActions", fields: [performedBy], references: [id])

  @@index([workflowId, createdAt])
  @@index([performedBy])
  @@index([action])
}

// System-wide audit log for compliance and traceability

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  // User.id (null for system actions)
  userRole  String?  // role at time of action
  userOrg   String?  // organization at time of action
  action    String   // e.g. "login", "document.submit", "shipment.view", "admin.user.create"
  resource  String   // e.g. "Shipment", "Document", "User", "Settings"
  resourceId String?  // specific entity ID
  details   String?  // JSON payload with action specifics
  ipAddress  String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([action])
  @@index([resource, resourceId])
  @@index([createdAt])
}

